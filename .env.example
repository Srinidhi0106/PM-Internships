# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Delivery Configuration (To dispatch real OTP directly to your email inbox):
# Option A: Gmail SMTP with 16-character App Password (Recommended for Gmail users)
# Generate at: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: Brevo API (https://brevo.com - 300 free emails/day to any recipient)
BREVO_API_KEY=

# Option C: Resend API (https://resend.com)
RESEND_API_KEY=

# Option D: SendGrid API
SENDGRID_API_KEY=

# Option E: Mailjet API
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Option F: Custom SMTP Server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

